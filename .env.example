# AWS Configuration for ClearClause AI (S3 and Textract still needed)
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
VITE_AWS_REGION=us-east-1

# AWS Services Configuration
VITE_S3_BUCKET=clearclauses3
VITE_TEXTRACT_LAMBDA=clearclause-textract
VITE_URL_LAMBDA=clearclause-url

# Google AI Configuration for Gemini
VITE_GOOGLE_AI_API_KEY=your_google_ai_api_key_here
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1/models

# Google Vision API for Image Extraction (OCR)
# Get your key from: https://console.cloud.google.com/
VITE_GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Anthropic Claude API for Text Processing
# Get your key from: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Firecrawl API for URL Extraction
# Get your key from: https://www.firecrawl.dev/
VITE_FIRECRAWL_API_KEY=your_firecrawl_api_key_here
